{
  "name": "buses-nieto-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sitio de Buses Nieto: venta de buses, minibuses y combis usados.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "lint": "eslint . && html-validate \"site/**/*.html\"",
    "test": "node --test \"tests/unit/*.test.mjs\" \"tests/security/*.test.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"site/js/**\" --test-coverage-include=\"scripts/**\" --test-coverage-lines=90 \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "audit": "npm audit --audit-level=high",
    "rdd:assess": "node scripts/rdd-assess.mjs",
    "check": "npm run lint && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "html-validate": "11.16.2"
  }
}
